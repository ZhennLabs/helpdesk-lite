APP_NAME="Helpdesk Lite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk_lite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=helpdesk_lite_session

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=helpdesk-lite-app
REVERB_APP_KEY=helpdesk-lite-key
REVERB_APP_SECRET=helpdesk-lite-secret
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8082
REVERB_HOST="0.0.0.0"
REVERB_PORT=8082
REVERB_SCHEME="http"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=""
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=helpdesk_lite_cache

HELPDESK_RSAM_API_URL=http://helpdek-rsam.test/api/external
HELPDESK_RSAM_API_KEY=rsam-helpdesk-api-secret-key-2026

VITE_APP_NAME="${APP_NAME}"